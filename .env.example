# Frontend environment variables
# Point this to your deployed backend base URL including /api prefix
VITE_API_URL=https://your-backend-service.up.railway.app/api
# Optional: set to production domain for any absolute links you might need
VITE_APP_URL=https://your-frontend-service.up.railway.app

# Meta App para conectar WhatsApp del empresario (Embedded Signup). Reutiliza la
# misma Meta App de salesfilter (plataforma unida).
VITE_FB_APP_ID=
VITE_FB_CONFIG_ID=
